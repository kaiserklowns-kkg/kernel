<script>
	import { onMount } from 'svelte';
	import { load, save } from '$lib/oceans.js';

	let text = $state('');
	let status = $state('Loading…');

	onMount(async () => {
		try {
			text = (await load('note')) ?? '';
			status = 'Saved notes are kept on your Oceans system.';
		} catch (e) {
			status = String(e);
		}
	});

	async function keep() {
		status = 'Saving…';
		try {
			await save('note', text);
			status = 'Saved.';
		} catch (e) {
			status = String(e);
		}
	}
</script>

<main>
	<h1>{{NAME}}</h1>
	<p class="muted">An Oceans web app, made with SvelteKit and the Oceans SDK.</p>
	<label for="note">Note</label>
	<textarea id="note" bind:value={text} rows="8" maxlength="16000"></textarea>
	<button onclick={keep}>Save</button>
	<p role="status" class="muted">{status}</p>
</main>

