# Oceans apps build for x86_64 with no OS underneath, in the lower half of
# the address space (the small code model).
[build]
target = "x86_64-unknown-none"

[target.x86_64-unknown-none]
rustflags = [
    "-C", "code-model=small", "-C", "relocation-model=static",
    # Software-only crypto (ADR-0031): the kernel does not save SIMD state,
    # so runtime-detected SSE/AVX/AES-NI paths must never run.
    "--cfg", "aes_force_soft", "--cfg", "polyval_force_soft",
    "--cfg", "chacha20_force_soft", "--cfg", "poly1305_force_soft",
    "--cfg", 'curve25519_dalek_backend="serial"',
]
